<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobpilotai.controller.CompanyController" style="-fx-background-color: #1a1a1a;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Text text="🏢 Company Insights" style="-fx-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: #242424; -fx-table-cell-border-color: #333333; -fx-text-fill: white;">
        <columns>
            <TableColumn fx:id="colName" text="Company Name" prefWidth="250" />
            <TableColumn fx:id="colApps" text="Total Applications" prefWidth="150" />
            <TableColumn fx:id="colInterviews" text="Interviews" prefWidth="150" />
            <TableColumn fx:id="colOffers" text="Offers" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
