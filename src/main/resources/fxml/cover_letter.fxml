<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobpilotai.controller.CoverLetterController" styleClass="page-root">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <VBox spacing="3">
        <Label text="Universal Cover Letter" styleClass="page-title"/>
        <Label text="Paste a generic cover letter below. The automation engine will use this if a job application requires one."
               style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #334155; -fx-border-radius: 8;">
        <TextArea fx:id="taCoverLetter" wrapText="true" VBox.vgrow="ALWAYS" promptText="Dear Hiring Manager..." style="-fx-control-inner-background: #0F172A; -fx-text-fill: #E2E8F0; -fx-font-size: 14px;"/>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label fx:id="lblStatus" text="" style="-fx-text-fill: #10B981; -fx-font-size: 12px;"/>
            <Button text="💾 Save Cover Letter" onAction="#onSave" styleClass="btn-primary" style="-fx-padding: 8 20;"/>
        </HBox>
    </VBox>
</VBox>
