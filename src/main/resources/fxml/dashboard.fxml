<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jobpilotai.controller.DashboardController"
      styleClass="page-root" spacing="0">

    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- ══════════════  HEADER  ══════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 0 0 24 0;">
        <VBox spacing="4">
            <Label text="Dashboard" styleClass="page-title"/>
            <Label fx:id="dateTimeLabel" styleClass="datetime-label"
                   text="Loading…"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="appVersionLabel" text="JobPilotAI v1.0.0"
               style="-fx-text-fill: #475569; -fx-font-size: 12px;
                      -fx-background-color: #1E293B;
                      -fx-background-radius: 20;
                      -fx-padding: 5 14;
                      -fx-border-color: #334155;
                      -fx-border-radius: 20;
                      -fx-border-width: 1;"/>
    </HBox>

    <!-- ══════════════  STAT CARDS  ══════════════ -->
    <HBox spacing="14" style="-fx-padding: 0 0 20 0;">

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="📤" style="-fx-font-size: 22px;"/>
            <Label text="TODAY" styleClass="stat-label"/>
            <Label fx:id="statToday" text="0" styleClass="stat-value"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="✅" style="-fx-font-size: 22px;"/>
            <Label text="SUCCESSFUL" styleClass="stat-label"/>
            <Label fx:id="statSuccess" text="0" styleClass="stat-value stat-value-success"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="🔵" style="-fx-font-size: 22px;"/>
            <Label text="APPLIED" styleClass="stat-label"/>
            <Label fx:id="statAlreadyApplied" text="0" styleClass="stat-value stat-value-info"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="❌" style="-fx-font-size: 22px;"/>
            <Label text="FAILED" styleClass="stat-label"/>
            <Label fx:id="statFailed" text="0" styleClass="stat-value stat-value-danger"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="🔑" style="-fx-font-size: 22px;"/>
            <Label text="OTP" styleClass="stat-label"/>
            <Label fx:id="statPendingOtp" text="0" styleClass="stat-value stat-value-warning"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="🤖" style="-fx-font-size: 22px;"/>
            <Label text="CAPTCHA" styleClass="stat-label"/>
            <Label fx:id="statPendingCaptcha" text="0" styleClass="stat-value stat-value-purple"/>
        </VBox>

    </HBox>

    <!-- ══════════════  BOTTOM ROW  ══════════════ -->
    <HBox spacing="14" VBox.vgrow="ALWAYS">

        <!-- Live Info Card -->
        <VBox styleClass="info-card" HBox.hgrow="ALWAYS" spacing="0">

            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 18 0;">
                <Label text="⚡" style="-fx-font-size: 16px;"/>
                <Label text="Live Information" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="systemStatusLabel" text="● Ready"
                       style="-fx-text-fill: #22C55E; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Grid of live info -->
            <GridPane hgap="0" vgap="0" style="-fx-padding: 0 0 20 0;">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Row 0 -->
                <VBox style="-fx-padding: 10 12; -fx-background-color: #0F172A; -fx-background-radius: 10 0 0 0; -fx-border-color: #1E3A5F; -fx-border-width: 0 1 1 0;"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Running Task" styleClass="info-key"/>
                </VBox>
                <VBox style="-fx-padding: 10 16; -fx-background-color: #0F172A; -fx-background-radius: 0 10 0 0; -fx-border-color: #1E3A5F; -fx-border-width: 0 0 1 0;"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label fx:id="runningTaskLabel" text="Idle" styleClass="info-value"/>
                </VBox>

                <!-- Row 1 -->
                <VBox style="-fx-padding: 10 12; -fx-background-color: #111827; -fx-border-color: #1E3A5F; -fx-border-width: 0 1 1 0;"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Website" styleClass="info-key"/>
                </VBox>
                <VBox style="-fx-padding: 10 16; -fx-background-color: #111827; -fx-border-color: #1E3A5F; -fx-border-width: 0 0 1 0;"
                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label fx:id="currentWebsiteLabel" text="—" styleClass="info-value"/>
                </VBox>

                <!-- Row 2 -->
                <VBox style="-fx-padding: 10 12; -fx-background-color: #0F172A; -fx-border-color: #1E3A5F; -fx-border-width: 0 1 1 0;"
                      GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Company" styleClass="info-key"/>
                </VBox>
                <VBox style="-fx-padding: 10 16; -fx-background-color: #0F172A; -fx-border-color: #1E3A5F; -fx-border-width: 0 0 1 0;"
                      GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label fx:id="currentCompanyLabel" text="—" styleClass="info-value"/>
                </VBox>

                <!-- Row 3 -->
                <VBox style="-fx-padding: 10 12; -fx-background-color: #111827; -fx-background-radius: 0 0 0 10; -fx-border-color: #1E3A5F; -fx-border-width: 0 1 0 0;"
                      GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Job Title" styleClass="info-key"/>
                </VBox>
                <VBox style="-fx-padding: 10 16; -fx-background-color: #111827; -fx-background-radius: 0 0 10 0;"
                      GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label fx:id="currentJobLabel" text="—" styleClass="info-value"/>
                </VBox>
            </GridPane>

            <!-- Progress -->
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Progress" styleClass="info-key"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="0%" style="-fx-text-fill: #3B82F6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
                <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity"
                             prefHeight="8"/>
            </VBox>

        </VBox>

        <!-- System Info Card -->
        <VBox styleClass="info-card" prefWidth="260" minWidth="240" spacing="0">

            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 18 0;">
                <Label text="🖥" style="-fx-font-size: 16px;"/>
                <Label text="System Info" styleClass="card-title"/>
            </HBox>

            <VBox spacing="0">
                <!-- Row template -->
                <HBox style="-fx-padding: 10 0; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <Label text="Platform" styleClass="info-key" minWidth="100"/>
                    <Label text="Windows 10 / 11" styleClass="info-value"/>
                </HBox>
                <HBox style="-fx-padding: 10 0; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <Label text="Language" styleClass="info-key" minWidth="100"/>
                    <Label text="Java 21 (LTS)" styleClass="info-value"/>
                </HBox>
                <HBox style="-fx-padding: 10 0; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <Label text="UI Framework" styleClass="info-key" minWidth="100"/>
                    <Label text="JavaFX 21" styleClass="info-value"/>
                </HBox>
                <HBox style="-fx-padding: 10 0; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <Label text="Database" styleClass="info-key" minWidth="100"/>
                    <Label text="SQLite (Local)" styleClass="info-value"/>
                </HBox>
                <HBox style="-fx-padding: 10 0; -fx-border-color: transparent transparent #1E3A5F transparent; -fx-border-width: 0 0 1 0;">
                    <Label text="Reports" styleClass="info-key" minWidth="100"/>
                    <Label text="Apache POI 5.x" styleClass="info-value"/>
                </HBox>
                <HBox style="-fx-padding: 10 0;">
                    <Label text="Build" styleClass="info-key" minWidth="100"/>
                    <Label text="Maven 3.9+" styleClass="info-value"/>
                </HBox>
            </VBox>

        </VBox>

    </HBox>

</VBox>
