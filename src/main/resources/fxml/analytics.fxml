<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobpilotai.controller.AnalyticsController" style="-fx-background-color: #1a1a1a;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Text text="📈 Analytics Dashboard" style="-fx-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="20">
        <!-- Key Metrics Cards -->
        <VBox spacing="5" style="-fx-background-color: #242424; -fx-background-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label text="Interview Rate" style="-fx-text-fill: #b3b3b3; -fx-font-size: 14px;"/>
            <Label fx:id="lblInterviewRate" text="0%" style="-fx-text-fill: #3498db; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="5" style="-fx-background-color: #242424; -fx-background-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label text="Offer Rate" style="-fx-text-fill: #b3b3b3; -fx-font-size: 14px;"/>
            <Label fx:id="lblOfferRate" text="0%" style="-fx-text-fill: #2ecc71; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Bar Chart -->
        <VBox style="-fx-background-color: #242424; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <BarChart fx:id="appsByMonthChart" title="Applications by Month" legendVisible="false">
                <xAxis><CategoryAxis label="Month" tickLabelFill="white"/></xAxis>
                <yAxis><NumberAxis label="Count" tickLabelFill="white"/></yAxis>
            </BarChart>
        </VBox>
        
        <!-- Pie Chart -->
        <VBox style="-fx-background-color: #242424; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <PieChart fx:id="statusPieChart" title="Application Status Breakdown" legendSide="BOTTOM" labelsVisible="true"/>
        </VBox>
    </HBox>

</VBox>
