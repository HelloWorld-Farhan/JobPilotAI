<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jobpilotai.controller.LogsController"
      styleClass="page-root" spacing="16">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Logs" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" text="Entries: 0" styleClass="count-badge"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="🔍  Search logs…" prefWidth="280" styleClass="search-field"/>
        <ComboBox  fx:id="levelCombo" prefWidth="120" styleClass="filter-combo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📋  Copy"    styleClass="btn-secondary" onAction="#onCopySelected"/>
        <Button text="🗑  Clear"   styleClass="btn-danger"    onAction="#onClearLogs"/>
        <Button text="🔄  Refresh" styleClass="btn-secondary" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colId"        text="ID"        prefWidth="50"/>
            <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="160"/>
            <TableColumn fx:id="colLevel"     text="Level"     prefWidth="80"/>
            <TableColumn fx:id="colMessage"   text="Message"   prefWidth="600"/>
        </columns>
    </TableView>

</VBox>
