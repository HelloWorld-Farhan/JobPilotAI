<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jobpilotai.controller.LogsController"
      styleClass="page-root" spacing="0">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 20 0;">
        <VBox spacing="3">
            <Label text="Logs" styleClass="page-title"/>
            <Label text="Search and monitor application log entries"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" text="Entries: 0" styleClass="count-badge"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar"
          style="-fx-padding: 10 14;">
        <TextField fx:id="searchField" promptText="🔍  Search log messages…"
                   prefWidth="280" styleClass="search-field"/>
        <ComboBox fx:id="levelCombo" prefWidth="130" styleClass="filter-combo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⎘  Copy"    styleClass="btn-secondary" onAction="#onCopySelected" prefHeight="38"/>
        <Button text="✕  Clear"   styleClass="btn-danger"    onAction="#onClearLogs"   prefHeight="38"/>
        <Button text="↺  Refresh" styleClass="btn-secondary" onAction="#onRefresh"      prefHeight="38"/>
    </HBox>

    <Region style="-fx-pref-height: 12; -fx-min-height: 12; -fx-max-height: 12;"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colId"        text="ID"        prefWidth="52"  minWidth="52"  maxWidth="70"/>
            <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="168" minWidth="140"/>
            <TableColumn fx:id="colLevel"     text="Level"     prefWidth="90"  minWidth="70"  maxWidth="110"/>
            <TableColumn fx:id="colMessage"   text="Message"   prefWidth="700" minWidth="200"/>
        </columns>
        <placeholder>
            <Label text="No log entries found."
                   style="-fx-text-fill: #475569; -fx-font-size: 14px;"/>
        </placeholder>
    </TableView>

</VBox>
