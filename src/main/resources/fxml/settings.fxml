<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jobpilotai.controller.SettingsController"
      styleClass="page-root" spacing="0">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 22 0;">
        <VBox spacing="3">
            <Label text="Settings" styleClass="page-title"/>
            <Label text="Configure your JobPilotAI preferences"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <!-- Scrollable settings -->
    <ScrollPane fitToWidth="true" styleClass="settings-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="16" style="-fx-padding: 0 4 0 0;">

            <!-- ── User Profile ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" style="-fx-font-size: 16px;"/>
                    <Label text="User Profile" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <GridPane hgap="20" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Full Name" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfFullName" promptText="Your full name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    
                    <Label text="Phone" styleClass="settings-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfPhone" promptText="Phone number" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="City" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfCity" promptText="City" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Country" styleClass="settings-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfCountry" promptText="Country" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="LinkedIn URL" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="tfLinkedinUrl" promptText="https://linkedin.com/in/..." GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                    
                    <Label text="GitHub URL" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="tfGithubUrl" promptText="https://github.com/..." GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <!-- ── Application Auto-Fill Profile ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋" style="-fx-font-size: 16px;"/>
                    <Label text="Application Auto-Fill Profile" styleClass="card-title" style="-fx-font-size: 18px;"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>
                                
                <VBox spacing="5">
                    <Label text="LinkedIn Profile URL" styleClass="settings-label"/>
                    <TextField fx:id="tfLinkedInUrl" promptText="https://www.linkedin.com/in/yourprofile" styleClass="text-field"/>
                    <Label text="Used for Auto-Pilot profile targeting." styleClass="settings-hint"/>
                </VBox>
                                
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="130"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Current Salary" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfCurrentSalary" promptText="e.g. 80000" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    
                    <Label text="Expected Salary" styleClass="settings-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfExpectedSalary" promptText="e.g. 100000" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Years of Experience" styleClass="settings-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfYearsExp" promptText="e.g. 3" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <CheckBox fx:id="chkCurrentlyEmployed" text="Currently Employed" styleClass="settings-checkbox" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkRequireSponsorship" text="Require Sponsorship" styleClass="settings-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>

            <!-- ── File Paths ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📁" style="-fx-font-size: 16px;"/>
                    <Label text="File Paths" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Resume Path" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfResumePath" promptText="Path to your resume file…" HBox.hgrow="ALWAYS"/>
                    <Button text="Browse…" styleClass="btn-secondary" onAction="#onBrowseResume" prefHeight="38"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Report Folder" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfReportFolder" promptText="Report output folder…" HBox.hgrow="ALWAYS"/>
                    <Button text="Browse…" styleClass="btn-secondary" onAction="#onBrowseReportFolder" prefHeight="38"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Log Folder" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfLogFolder" promptText="Log output folder…" HBox.hgrow="ALWAYS"/>
                    <Button text="Browse…" styleClass="btn-secondary" onAction="#onBrowseLogFolder" prefHeight="38"/>
                </HBox>
            </VBox>

            <!-- ── Account & Email ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📧" style="-fx-font-size: 16px;"/>
                    <Label text="Account &amp; Email" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Default Email" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfDefaultEmail" promptText="your@email.com" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="GAS Web App URL" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfGasUrl" promptText="https://script.google.com/macros/s/…" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- ── AI & Intelligence ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🤖" style="-fx-font-size: 16px;"/>
                    <Label text="AI Intelligence" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Enable AI Features" styleClass="settings-label" minWidth="130"/>
                    <CheckBox fx:id="chkAiEnabled"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Gemini API Key" styleClass="settings-label" minWidth="130"/>
                    <TextField fx:id="tfGeminiApiKey" promptText="AIzaSy…" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- ── Appearance ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🎨" style="-fx-font-size: 16px;"/>
                    <Label text="Appearance" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <HBox alignment="CENTER_LEFT" spacing="24">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Theme" styleClass="settings-label" minWidth="100"/>
                        <ComboBox fx:id="cbTheme" prefWidth="130"/>
                    </HBox>
                    <CheckBox fx:id="chkDarkMode" text="Dark Mode" styleClass="settings-checkbox"/>
                </HBox>
            </VBox>

            <!-- ── Behaviour ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⚙" style="-fx-font-size: 16px;"/>
                    <Label text="Behaviour" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <GridPane hgap="40" vgap="12">
                    <CheckBox fx:id="chkNotifications" text="Enable Windows Notifications"
                              styleClass="settings-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <CheckBox fx:id="chkEmail"         text="Enable Email Notifications"
                              styleClass="settings-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <CheckBox fx:id="chkAutoSave"      text="Auto Save Session"
                              styleClass="settings-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkAutoReports"   text="Auto Generate Reports"
                              styleClass="settings-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkRememberSize"  text="Remember Window Size"
                              styleClass="settings-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <CheckBox fx:id="chkRememberPosition" text="Remember Window Position"
                              styleClass="settings-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>

            <!-- ── Automation ── -->
            <VBox styleClass="settings-card" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🤖" style="-fx-font-size: 16px;"/>
                    <Label text="Automation" styleClass="settings-section-title"/>
                </HBox>
                <Separator style="-fx-opacity: 0.4;"/>

                <HBox alignment="CENTER_LEFT" spacing="24">
                    <CheckBox fx:id="chkHeadless" text="Headless Mode (Background Browser)" styleClass="settings-checkbox"/>
                    <CheckBox fx:id="chkScreenshotError" text="Take Screenshot on Error" styleClass="settings-checkbox"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Timeout (ms)" styleClass="settings-label" minWidth="100"/>
                    <TextField fx:id="tfTimeout" promptText="30000" prefWidth="100"/>
                    <Label text="Max Retries" styleClass="settings-label" minWidth="100"/>
                    <TextField fx:id="tfRetries" promptText="3" prefWidth="100"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
        <Button text="Reset Defaults" styleClass="btn-secondary" onAction="#onReset" prefHeight="40"/>
        <Button text="💾  Save Settings" styleClass="btn-primary" onAction="#onSave" prefHeight="40"/>
    </HBox>

</VBox>
