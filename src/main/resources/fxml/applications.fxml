<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jobpilotai.controller.ApplicationsController"
      styleClass="page-root" spacing="0">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 20 0;">
        <VBox spacing="3">
            <Label text="Applications" styleClass="page-title"/>
            <Label text="Manage and track all your job applications"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" text="Total: 0" styleClass="count-badge"/>
    </HBox>

    <!-- Toolbar -->
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar"
          style="-fx-padding: 10 14; -fx-margin: 0 0 16 0;">
        <TextField fx:id="searchField"
                   promptText="🔍  Search company, title, notes…"
                   prefWidth="280" styleClass="search-field"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="170" styleClass="filter-combo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="＋  Add"       styleClass="btn-primary"   onAction="#onAddApplication" prefHeight="38"/>
        <Button text="✏  Edit"      styleClass="btn-secondary"  onAction="#onEditSelected"   prefHeight="38"/>
        <Button text="✕  Delete"    styleClass="btn-danger"     onAction="#onDeleteSelected" prefHeight="38"/>
        <Button text="✕  Clear All" styleClass="btn-danger"     onAction="#onDeleteAll"      prefHeight="38"/>
        <Button text="↓  Export"    styleClass="btn-secondary"  onAction="#onExportExcel"    prefHeight="38"/>
        <Button text="↺  Refresh"   styleClass="btn-secondary"  onAction="#onRefresh"        prefHeight="38"/>
    </HBox>

    <!-- Spacer -->
    <Region style="-fx-pref-height: 12; -fx-min-height: 12; -fx-max-height: 12;"/>

    <!-- Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colId"          text="ID"           prefWidth="50" />
            <TableColumn fx:id="colCompany"     text="Company"      prefWidth="150" />
            <TableColumn fx:id="colJobTitle"    text="Job Title"    prefWidth="200" />
            <TableColumn fx:id="colStatus"      text="Status"       prefWidth="120" />
            <TableColumn fx:id="colDate"        text="Date"         prefWidth="100" />
            <TableColumn fx:id="colLocation"    text="Location"     prefWidth="120" />
            <TableColumn fx:id="colSalary"      text="Salary"       prefWidth="100" />
            <TableColumn fx:id="colRecruiter"   text="Recruiter"    prefWidth="120" />
            <TableColumn fx:id="colResume"      text="Resume Used"  prefWidth="120" />
        </columns>
        <placeholder>
            <Label text="No applications yet. Click ＋ Add to get started."
                   style="-fx-text-fill: #475569; -fx-font-size: 14px;"/>
        </placeholder>
    </TableView>

</VBox>
