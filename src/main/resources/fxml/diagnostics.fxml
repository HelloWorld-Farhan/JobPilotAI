<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobpilotai.controller.DiagnosticsController" style="-fx-background-color: #1a1a1a;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Text text="🩺 Diagnostics Center" style="-fx-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="20">
        <!-- System Status -->
        <VBox spacing="10" style="-fx-background-color: #242424; -fx-background-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label text="System" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Label text="Java Version:" style="-fx-text-fill: #b3b3b3;"/>
                <Label fx:id="lblJavaVersion" text="Loading..." style="-fx-text-fill: white;"/>
            </HBox>
            
            <Label text="Memory Usage" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>
            <ProgressBar fx:id="pbMemory" progress="0.0" maxWidth="Infinity"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblMemoryUsed" text="0 MB" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                <Label text="/" style="-fx-text-fill: #b3b3b3;"/>
                <Label fx:id="lblMemoryMax" text="0 MB" style="-fx-text-fill: #b3b3b3;"/>
            </HBox>
        </VBox>

        <!-- Database Status -->
        <VBox spacing="10" style="-fx-background-color: #242424; -fx-background-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label text="Database (SQLite)" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Label text="Status:" style="-fx-text-fill: #b3b3b3;"/>
                <Label fx:id="lblDbStatus" text="Loading..." style="-fx-text-fill: white;"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Size:" style="-fx-text-fill: #b3b3b3;"/>
                <Label fx:id="lblDbSize" text="Loading..." style="-fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
